# Custom Aliases

# Safer remove
alias rm='rm -i'

# Better listing
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Show disk usage
alias dfh='df -h'

# Show memory usage
alias mem='free -h'

# Update system
alias update='sudo apt update && sudo apt upgrade -y'

# Clear screen
alias c='clear'

# Show public IP
alias myip='curl ifconfig.me'

# Git shortcuts
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
